# Copy to .env and fill in what you have. Everything is optional: the
# assistant works without any key, it just says so in the response.

# Air quality station for the grid bias correction.
# WAQI: free token from waqi.info, email is enough.
WAQI_TOKEN=

# OpenAQ v3 key (optional, measured pollutants as a second station source).
OPENAQ_API_KEY=

# India open data: data.gov.in API key (optional, CPCB station AQI).
DATA_GOV_IN_KEY=

# OpenRouteService (optional fallback for OSRM).
ORS_API_KEY=

# Contact details for the OSM User-Agent policy. Do NOT use a placeholder
# domain: Overpass answers 403 or 406 to any User-Agent containing
# "example.com". Use a real address or the repository URL.
CONTACT_EMAIL=
REPO_URL=https://github.com/DRK28122006/GeoAI

# Local model.
SLM_MODEL_PATH=models/Qwen3-1.7B-Q4_K_M.gguf
SLM_BACKEND=inprocess
SLM_N_THREADS=4
SLM_N_CTX=4096
SLM_EAGER_LOAD=true

# App.
CACHE_DIR=.cache
LOG_LEVEL=INFO
